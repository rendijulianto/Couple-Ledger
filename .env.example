# Environment Mode
NODE_ENV=development

# Host Exposed Ports (mapped to avoid conflicts on host machine)
DB_PORT=5436
API_PORT=3000
WEB_PORT=5174

# Database Credentials
POSTGRES_USER=ledger_dev
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_DB=couple_ledger_dev

# Database URLs
# For Docker internal network:
DATABASE_URL=postgresql://ledger_dev:ledger_dev_password@postgres:5432/couple_ledger_dev
# For host local connection (e.g. running migrations outside docker):
# DATABASE_URL=postgresql://ledger_dev:ledger_dev_password@localhost:5436/couple_ledger_dev

# Application Config
APP_SECRET=dev_super_secret_key_at_least_32_characters_long
API_URL=http://localhost:3000
WEB_URL=http://localhost:5174

# Telegram Bot (Optional for Dev Fase 0)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=dev_webhook_secret_123

