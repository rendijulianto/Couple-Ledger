# ==========================================
# Couple Ledger - Production Environment (.env.prod)
# Salin file ini menjadi .env.prod dan isi nilai rahasia asli
# ==========================================

APP_ENV=production
NODE_ENV=production
APP_VERSION=0.1.0
APP_PORT=3000

# Database Configuration (Docker network 'db')
POSTGRES_USER=ledger_prod
POSTGRES_PASSWORD=ganti_dengan_password_db_sangat_kuat_dan_rahasia_123
POSTGRES_DB=couple_ledger_prod
DATABASE_URL=postgresql://ledger_prod:ganti_dengan_password_db_sangat_kuat_dan_rahasia_123@db:5432/couple_ledger_prod

# Authentication & Encryption Secret (Minimal 32 karakter)
APP_SECRET=ganti_dengan_secret_jwt_produksi_minimal_32_karakter_acak

# Frontend Public URL (Domain HTTPS Anda)
WEB_URL=https://ledger.example.com

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ_example
TELEGRAM_WEBHOOK_SECRET=ganti_dengan_secret_header_webhook_acak_anda

# Backup Retention Policy (Hari, Minggu, Bulan)
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_WEEKS=8
BACKUP_RETENTION_MONTHS=6

