{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun && bun build src/db/migrate.ts --outfile dist/migrate.js --target bun",
    "start": "bun dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun dist/migrate.js || bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:reset:local": "bun run src/db/reset.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun test"
  },
  "dependencies": {
    "@couple-ledger/shared": "workspace:*",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@sinclair/typebox": "^0.34.14",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.2.10",
    "grammy": "^1.46.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3"
  }
}
